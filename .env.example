# Active LLM Provider: "nvidia" (default) or "nebius"
LLM_PROVIDER=nvidia

# NVIDIA Hosted NIM API (from build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_REASONING=nvidia/nemotron-3.5-lightning-30b-a3b

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_FAST=nvidia/Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily AI Search (for live web evidence retrieval)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional overrides across providers
# MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
# DEMO_MODE=false
# CACHE_TTL_SECONDS=900
# MAX_INPUT_LENGTH=5000
# ALLOWED_ORIGINS=http://localhost:8000
